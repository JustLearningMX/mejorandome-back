// Prisma Schema — Control Personal de Salud
// Base de datos: MySQL (OCI Always Free)
// Documentación de referencia: .references/bd/bd_architecture.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
model User {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @unique @db.VarChar(254)
  name      String   @db.VarChar(255)
  timezone  String   @default("America/Mexico_City") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authIdentities AuthIdentity[]
  healthDays     HealthDay[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// AuthIdentity
// ---------------------------------------------------------------------------
model AuthIdentity {
  id              String   @id @default(uuid()) @db.Char(36)
  userId          String   @map("user_id") @db.Char(36)
  provider        String   @db.VarChar(64)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("auth_identities")
}

// ---------------------------------------------------------------------------
// HealthDay — contenedor de registros del día
// ---------------------------------------------------------------------------
model HealthDay {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  localDate DateTime @map("local_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  weightMeasurements WeightMeasurement[]
  mealEntries        MealEntry[]
  exerciseSessions   ExerciseSession[]
  dailyActivity      DailyActivity?
  sleepRecord        SleepRecord?
  healthNotes        HealthNote[]

  @@unique([userId, localDate])
  @@index([userId])
  @@map("health_days")
}

// ---------------------------------------------------------------------------
// WeightMeasurement
// ---------------------------------------------------------------------------
model WeightMeasurement {
  id          String   @id @default(uuid()) @db.Char(36)
  healthDayId String   @map("health_day_id") @db.Char(36)
  weightKg    Decimal  @map("weight_kg") @db.Decimal(5, 2)
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  healthDay HealthDay @relation(fields: [healthDayId], references: [id], onDelete: Cascade)

  @@index([healthDayId])
  @@map("weight_measurements")
}

// ---------------------------------------------------------------------------
// MealEntry
// ---------------------------------------------------------------------------
model MealEntry {
  id                   String    @id @default(uuid()) @db.Char(36)
  healthDayId          String    @map("health_day_id") @db.Char(36)
  mealType             MealType  @map("meal_type")
  occurredAt           DateTime  @map("occurred_at")
  description          String?   @db.Text
  hungerBefore         Int?      @map("hunger_before") @db.TinyInt
  satietyAfter         Int?      @map("satiety_after") @db.TinyInt
  wantedMoreEvenIfFull Boolean?  @default(false) @map("wanted_more_even_if_full")
  pausedBeforeMore     Boolean?  @map("paused_before_more")
  extraEatingContext   String?   @map("extra_eating_context") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")

  healthDay HealthDay @relation(fields: [healthDayId], references: [id], onDelete: Cascade)

  @@index([healthDayId])
  @@map("meal_entries")
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
  other
}

// ---------------------------------------------------------------------------
// ExerciseSession
// ---------------------------------------------------------------------------
model ExerciseSession {
  id              String    @id @default(uuid()) @db.Char(36)
  healthDayId     String    @map("health_day_id") @db.Char(36)
  activityType    String    @map("activity_type") @db.VarChar(128)
  durationMinutes Int       @map("duration_minutes") @db.SmallInt
  startedAt       DateTime? @map("started_at")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  healthDay HealthDay @relation(fields: [healthDayId], references: [id], onDelete: Cascade)

  @@index([healthDayId])
  @@map("exercise_sessions")
}

// ---------------------------------------------------------------------------
// DailyActivity — pasos del día
// ---------------------------------------------------------------------------
model DailyActivity {
  id          String   @id @default(uuid()) @db.Char(36)
  healthDayId String   @unique @map("health_day_id") @db.Char(36)
  steps       Int
  source      String   @default("manual") @db.VarChar(64)
  recordedAt  DateTime @map("recorded_at")

  healthDay HealthDay @relation(fields: [healthDayId], references: [id], onDelete: Cascade)

  @@map("daily_activities")
}

// ---------------------------------------------------------------------------
// SleepRecord
// ---------------------------------------------------------------------------
model SleepRecord {
  id              String    @id @default(uuid()) @db.Char(36)
  healthDayId     String    @unique @map("health_day_id") @db.Char(36)
  durationMinutes Int       @map("duration_minutes") @db.SmallInt
  sleepStartedAt  DateTime? @map("sleep_started_at")
  sleepEndedAt    DateTime? @map("sleep_ended_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  healthDay HealthDay @relation(fields: [healthDayId], references: [id], onDelete: Cascade)

  @@map("sleep_records")
}

// ---------------------------------------------------------------------------
// HealthNote
// ---------------------------------------------------------------------------
model HealthNote {
  id          String   @id @default(uuid()) @db.Char(36)
  healthDayId String   @map("health_day_id") @db.Char(36)
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  healthDay HealthDay @relation(fields: [healthDayId], references: [id], onDelete: Cascade)

  @@index([healthDayId])
  @@map("health_notes")
}
