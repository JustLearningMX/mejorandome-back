# Entorno de ejecución
NODE_ENV=development
PORT=3005

# CORS (Frontend URLs separadas por coma)
CORS_ORIGIN=http://localhost:4321,https://justlearningmx.github.io

# Base de datos MySQL — Prisma
DATABASE_URL="mysql://usuario:contraseña@host:3306/nombre_base_de_datos"

# Google OAuth
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"

# JWT Auth
JWT_SECRET="tu-clave-secreta-para-firmar-jwt-de-sesion"
JWT_EXPIRES_IN="7d"

# Refresh token (cookie httpOnly). Con REFRESH_TOKENS_ENABLED=false el login se comporta como antes.
# En producción usar JWT_EXPIRES_IN="1h" al activarlo.
REFRESH_TOKENS_ENABLED=false
REFRESH_TOKEN_TTL_DAYS=30
# Path público de la cookie; en el VPS: /mejorandome-back/v1/api/auth
REFRESH_COOKIE_PATH=/api/auth
