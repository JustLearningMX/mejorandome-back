# Entorno de ejecución
NODE_ENV=development
PORT=3005

# CORS (Frontend URLs separadas por coma)
CORS_ORIGIN=http://localhost:4321,https://justlearningmx.github.io

# Base de datos MySQL — Prisma
DATABASE_URL="mysql://usuario:contraseña@host:3306/nombre_base_de_datos"

# Google OAuth
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"

# JWT Auth
JWT_SECRET="tu-clave-secreta-para-firmar-jwt-de-sesion"
JWT_EXPIRES_IN="7d"
